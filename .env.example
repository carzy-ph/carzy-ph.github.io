# Copy this file to .env.local and fill in your Supabase project (README step 3).
# Both values are public by design: the database rules in supabase/schema.sql protect the data.
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_YOUR-KEY

# Optional: Google OAuth client ID (…apps.googleusercontent.com). Shows Google's sign-in button on the
# portal itself, so Google's screen names this site. Public by design; the client secret stays in Supabase.
VITE_GOOGLE_CLIENT_ID=
